# ─── Obligatorias (la app no arranca sin ellas) ───────────────────────────────

# PostgreSQL connection string usado por Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/backend_emd?schema=public"

# Secreto para firmar/verificar los JWT. MÍNIMO 32 caracteres.
JWT_SECRET="replace-with-a-long-random-secret-min-32-chars"

# ─── Opcionales (tienen default) ─────────────────────────────────────────────

# Entorno: development | test | production (default: development)
NODE_ENV="development"

# Puerto (Render inyecta PORT automáticamente). Default de BACKEND_PORT: 3001
PORT=3001
BACKEND_PORT=3001

# Origen permitido para CORS y para el gateway de Socket.io.
# Acepta varios separados por coma. Default: http://localhost:3000
FRONTEND_URL="http://localhost:3000"

# Secreto separado para los refresh tokens. Mín 32 chars. OBLIGATORIO en
# producción y distinto de JWT_SECRET (fuera de producción cae a JWT_SECRET).
JWT_REFRESH_SECRET=""

# Duración del access token (default: 15m) y del refresh token (default: 7d).
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis para escalar Socket.io horizontalmente. Si no se define, el gateway
# funciona en memoria (correcto con UNA sola instancia).
REDIS_URL=""

# Si ambas se definen, /api/docs queda protegido con basic auth.
SWAGGER_USER=""
SWAGGER_PASSWORD=""

# Rate limiting global (default: 60 requests por 60000 ms)
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# Contraseña del admin creado por `prisma db seed`. OBLIGATORIA en producción
# (fuera de producción el default es Admin123!). Un admin existente NO se toca
# salvo que se defina SEED_RESET_ADMIN=true.
SEED_ADMIN_PASSWORD="Admin123!"
SEED_RESET_ADMIN=""

# Saltos de proxy confiables para req.ip (default 1, correcto en Render).
TRUST_PROXY_HOPS=1

# ─── Web Push (notificaciones push del navegador) ────────────────────────────
# Par de claves VAPID para firmar los pushes. Generar con:
#   npx web-push generate-vapid-keys
# Sin estas tres variables, el envío de push queda deshabilitado (el resto de
# la app sigue funcionando igual, sólo no llegan pushes al navegador).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contacto del "sujeto" del VAPID (mailto: o https:), requerido por la spec.
VAPID_SUBJECT="mailto:soporte@emdbordados.com"

# ─── Reporte de errores por email (Resend) ───────────────────────────────────
# Sin RESEND_API_KEY el endpoint POST /bug-reports responde 503 y NO se envía
# ningún email. En Render hay que definirla en Environment del servicio.
# Formato: la API key de https://resend.com/api-keys (empieza con "re_").
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Casilla que recibe los reportes (default: eguiajosue@gmail.com)
BUG_REPORT_RECIPIENT="tu-email@ejemplo.com"

# Remitente. Default: "EMD Bordados <onboarding@resend.dev>".
# IMPORTANTE: onboarding@resend.dev es el dominio de pruebas compartido de
# Resend y SOLO entrega al email con el que se creó la cuenta de Resend. Para
# enviar a cualquier otra casilla hay que verificar un dominio propio en Resend
# y usar una dirección de ese dominio, p. ej. "EMD Bordados <bugs@midominio.com>".
BUG_REPORT_FROM="EMD Bordados <bugs@midominio.com>"

# ─── Almacenamiento de archivos (Cloudflare R2 / S3) ─────────────────────────
# Ver docs/storage-r2.md. "db" (default) = los archivos siguen en base64 dentro
# de Postgres, como siempre. "s3" = los archivos nuevos van al bucket y en la
# fila queda sólo la clave; con "s3" las cuatro S3_* de abajo son obligatorias.
STORAGE_DRIVER="db"
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com (R2) o el endpoint de tu S3.
S3_ENDPOINT=""
# En R2 siempre "auto".
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Monitoreo de errores (Sentry) ───────────────────────────────────────────
# Ver docs/monitoring.md. Sin SENTRY_DSN Sentry queda APAGADO. Se lee directo
# del entorno al arrancar (src/instrument.ts), antes que este .env: en local
# hay que exportarla en la shell para probarla.
SENTRY_DSN=""
# Default: NODE_ENV.
SENTRY_ENVIRONMENT=""
# Fracción de requests con traza de performance (0 a 1). Default 0 = sólo errores.
SENTRY_TRACES_SAMPLE_RATE=0
