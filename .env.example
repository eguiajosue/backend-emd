# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/backend_emd?schema=public"

# Secret used to sign and verify JWT tokens
JWT_SECRET="replace-with-a-long-random-secret"

# Port the server listens on (PaaS providers like Render inject PORT automatically)
PORT=3001

# Fallback port used locally when PORT is not set
BACKEND_PORT=3001

# Allowed origin for CORS and the Socket.io gateway
FRONTEND_URL="http://localhost:3000"
