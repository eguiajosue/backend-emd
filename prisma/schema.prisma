generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id       Int     @id @default(autoincrement()) // Identificador único de la empresa.
  name     String  @unique // Nombre de la empresa.
  phone    String? // Número de teléfono de la empresa.
  email    String? // Dirección de correo electrónico de la empresa.
  address  String? // Dirección física de la empresa.
  location String? // Ubicación de la empresa (por ejemplo, ciudad, estado).

  clients Client[] // Relación uno a muchos con el modelo Client.
}

model Client {
  id         Int     @id @default(autoincrement()) // Identificador único del cliente.
  companyId  Int? // Clave foránea que referencia a Company.
  first_name String // Nombre del cliente.
  last_name  String? // Apellido del cliente (opcional).
  phone      String? // Número de teléfono del cliente.
  email      String? // Dirección de correo electrónico del cliente.
  address    String? // Dirección física del cliente.
  branchId   Int? // Sucursal dueña del cliente (cada sucursal tiene los suyos). Null = cliente de la matriz.

  company        Company?        @relation(fields: [companyId], references: [id]) // Relación con Company.
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull) // Sucursal dueña (ver Branch).
  orders         Order[] // Relación uno a muchos con el modelo Order.
  calendarEvents CalendarEvent[] // Eventos del calendario de Recepción vinculados a este cliente.
  orderTemplates OrderTemplate[] // Plantillas de pedido de este cliente (lo que suele pedir).
  insight        ClientInsight? // Hábitos aprendidos de su historial de pedidos (autocompletado del alta).
  quotes         Quote[] // Cotizaciones de este cliente (tablero de Cotizaciones de Recepción).

  @@index([companyId])
  @@index([last_name, first_name])
  @@index([branchId])
}

model Role {
  id    Int    @id @default(autoincrement()) // Identificador único del rol.
  name  String @unique // Nombre del rol (por ejemplo, Admin, User).
  users User[] // Relación muchos a muchos con el modelo User.
}

model User {
  id              Int       @id @default(autoincrement()) // Identificador único del usuario.
  firstName       String // Nombre del usuario.
  lastName        String? // Apellido del usuario.
  username        String    @unique // Nombre de usuario único para iniciar sesión.
  password        String // Contraseña del usuario.
  isSharedAccount Boolean   @default(false) // Cuenta compartida por varias personas de un área (ej. "Taller"), en vez de una persona.
  branchId        Int? // Sucursal a la que pertenece la cuenta (sólo rol 'sucursal'; ej. "Punto Madero"). Null = usuario de la matriz.
  lastSeenAt      DateTime? // Última vez que se desconectó el último socket vivo de este usuario (ver NotificationsGateway.handleDisconnect). Null si nunca se conectó por WebSocket.

  roles                   Role[] // Relación muchos a muchos con Role: un usuario puede tener uno o más roles.
  branch                  Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull) // Sucursal de la cuenta (ver Branch).
  orders                  Order[] // Relación uno a muchos con Order (pedidos creados por el usuario).
  assignedOrders          Order[]                  @relation("AssignedOrders") // Pedidos asignados a este usuario para trabajarlos.
  attendedOrders          Order[]                  @relation("AttendedOrders") // Pedidos de Recepción que esta persona está atendiendo (los tomó de otra recepcionista).
  assignedAreaTasks       OrderAreaTask[]          @relation("AssignedAreaTasks") // Tareas de área de producción asignadas a este usuario (o a su cuenta de área).
  logs                    Log[] // Relación uno a muchos con Log.
  orderNotes              OrderNote[] // Notas internas de pedidos escritas por este usuario.
  orderAuditLogs          OrderAuditLog[] // Registros de auditoría de ediciones de pedidos hechas por este usuario.
  notifications           Notification[] // Notificaciones persistentes dirigidas a este usuario.
  pushSubscriptions       PushSubscription[] // Suscripciones Web Push (una por navegador/dispositivo) de este usuario.
  expoPushTokens          ExpoPushToken[] // Tokens de push nativo (Mobile/Expo) de este usuario.
  designRevisionsSent     DesignRevision[]         @relation("DesignRevisionSentBy") // Montajes enviados por este usuario (diseñador).
  designRevisionsFeedback DesignRevision[]         @relation("DesignRevisionFeedbackBy") // Feedback cargado por este usuario (Recepción).
  designRevisionsApproved DesignRevision[]         @relation("DesignRevisionApprovedBy") // Autorizaciones marcadas por este usuario (Recepción).
  chatMemberships         ChatConversationMember[] // Conversaciones de chat en las que participa (incluye monitoreo de admin).
  chatMessages            ChatMessage[] // Mensajes de chat enviados por este usuario.
  chatDirectAsUserA       ChatConversation[]       @relation("ChatDirectUserA") // DMs donde es el participante de id menor.
  chatDirectAsUserB       ChatConversation[]       @relation("ChatDirectUserB") // DMs donde es el participante de id mayor.
  calendarEvents          CalendarEvent[]          @relation("CalendarEventCreatedBy") // Eventos del calendario de Recepción creados por este usuario.
  orderTemplatesCreated   OrderTemplate[]          @relation("OrderTemplateCreatedBy") // Plantillas de pedido que guardó este usuario.
  calendarTasks           CalendarTask[]           @relation("CalendarTaskCreatedBy") // Tareas pendientes (sin fecha) del calendario de equipo creadas por este usuario.
  orderMaterialItems      OrderMaterialItem[]      @relation("OrderMaterialItemCreatedBy") // Líneas de hoja de materiales cargadas por este usuario.
  inventoryMovements      InventoryMovement[]      @relation("InventoryMovementCreatedBy") // Entradas/salidas/ajustes de inventario registrados por este usuario.
  restockRequests         RestockRequest[]         @relation("RestockRequestRequestedBy") // Avisos de reabasto que levantó.
  restockRequestsHandled  RestockRequest[]         @relation("RestockRequestHandledBy") // Avisos de reabasto que atendió (Recepción/admin).
  orderMockupsCreated     OrderMockup[]            @relation("OrderMockupCreatedBy") // Mockups 3D (playera/gorra) que este usuario adjuntó a un pedido.
  mockupTemplatesCreated  MockupTemplate[]         @relation("MockupTemplateCreatedBy") // Plantillas de mockup (compartidas por la empresa) que guardó este usuario.
  mockupLogosCreated      MockupLogo[]             @relation("MockupLogoCreatedBy") // Logos de la biblioteca de mockups (compartida por la empresa) que subió este usuario.
  quotesCreated           Quote[]                  @relation("QuoteCreatedBy") // Cotizaciones que este usuario dio de alta.

  themePreference      String? // Preferencia de tema: 'light' | 'dark' | 'system'.
  accentColor          String? // Nombre de preset (ej "rose") o hex custom (ej "#3366ff").
  languagePreference   String? // Idioma preferido: 'es' | 'en'.
  glassIntensity       Int? // Intensidad del efecto Liquid Glass, 0-100.
  density              String? // Densidad de UI: 'comfortable' | 'compact'.
  hasSeenOnboarding    Boolean? // Si ya completó/cerró el tour de onboarding.
  areaViewMode         String? // Cómo ver las tareas de producción: 'unified' (todo junto, etiquetado por área) | 'split' (una vista por área). Preferencia personal, ver WORKFLOW.md §4.
  timeFormatPreference String? // Formato de hora: '24h' | '12h' (AM/PM).
  frequentProductIds   Json? // Productos frecuentes del alta de pedido elegidos y ordenados por este usuario (array de ids de OrderProductPreset). Null = usar el orden por defecto.
  navPreferences       Json? // Barra lateral personalizada de este usuario: { favorites: string[]; order: Record<grupo, string[]>; hidden: string[]; expanded: boolean } (ids = url del ítem). Null = barra por defecto.
  mockupColors         Json? // Colores propios del creador de mockups de este usuario: { favorites: string[]; custom: string[] } (hex #rrggbb, máx. 48 c/u). Null = sin colores guardados.

  notificationsMuted      Boolean @default(false) // Modo silencio general: si está activo, no se persisten ni pushean notificaciones (salvo menciones directas, cuando ese tipo exista).
  notifyMentionsOnly      Boolean @default(false) // Sólo notificar menciones directas. Sin efecto práctico hoy: el sistema no tiene un tipo de notificación de "mención" implementado aún (ver NotificationService).
  notifyProductionUpdates Boolean @default(true) // Notificar cambios de estado/asignación de pedidos y novedades de producción.
  notifyCriticalAlerts    Boolean @default(true) // Notificar alertas críticas y cualquier tipo de notificación no clasificado como "producción".
}

model Status {
  id                     Int            @id @default(autoincrement()) // Identificador único del estado.
  name                   String         @unique // Nombre del estado (por ejemplo, Pendiente).
  orders                 Order[] // Relación uno a muchos con Order.
  previousOrderHistories OrderHistory[] @relation("PreviousStatus") // Relación con OrderHistory donde este estado es el estado anterior.
  newOrderHistories      OrderHistory[] @relation("NewStatus") // Relación con OrderHistory donde este estado es el nuevo estado.
}

model Order {
  id                 Int       @id @default(autoincrement()) // Identificador único de la orden.
  clientId           Int? // Clave foránea que referencia a Client (opcional: puede haber cliente libre por nombre).
  clientNameOverride String? // Nombre de cliente escrito a mano cuando no se selecciona un cliente registrado.
  userId             Int // Clave foránea que referencia al User que creó la orden.
  assignedUserId     Int? // Clave foránea que referencia al User asignado para trabajar la orden.
  attendedByUserId   Int? // Clave foránea que referencia a la recepcionista que TOMÓ el pedido ("atender"). El creador (`userId`) no cambia nunca; este campo dice quién lo lleva hoy y es el destinatario efectivo de los avisos del circuito (ver WORKFLOW.md §2).
  statusId           Int // Clave foránea que referencia a Status (flujo: pendiente→en proceso→terminado→entregado, o el flujo con diseño: en diseño→esperando autorización→cambios solicitados→autorizado→...).
  area               String? // Departamento DONDE ESTÁ AHORA el pedido (gobierna visibilidad): taller | dtf | bordado | diseno | laser | impresiones.
  description        String // Descripción de la orden.
  creationDate       DateTime // Fecha en que se creó la orden.
  deliveryDate       DateTime? // Fecha de entrega opcional.

  requiresDesign Boolean @default(true) // Si el pedido pasa por la fase de Diseño antes de producción (decidido por Recepción al crear el pedido).
  productionArea String? // Área de producción destino una vez autorizado el diseño (uno de ORDER_AREAS salvo 'diseno'). Editable por recepción/admin/superuser y por usuarios con rol diseno.

  archivedAt DateTime? // Momento en que el pedido salió del tablero activo de Diseño al autorizarse el montaje. Queda en el historial, pero ya no es trabajo pendiente de Diseño (ver WORKFLOW.md §2).

  designStartedAt       DateTime? // Momento en que Diseño EMPEZÓ el montaje ("Empezar diseño" o "Tomar pedido"). null = nadie lo abrió todavía: Recepción lo ve como "sin empezar" y el tablero como "Nuevo".
  designStartedByName   String? // Quién lo empezó, tal cual se muestra. Con la cuenta compartida del área es el nombre que escribe la persona; si no, el nombre del usuario.
  designStartedByUserId Int? // Usuario (cuenta) desde el que se empezó; sin relación, sólo para auditoría.

  branchId         Int? // Sucursal desde la que se levantó el pedido (ej. "Punto Madero"). Null = pedido de la matriz.
  branchEmployeeId Int? // Empleado de la sucursal que levantó el pedido (obligatorio al crear desde la cuenta de sucursal).

  materialsPriority Int? // Orden de prioridad de compra elegido a mano (drag & drop) en "Hoja de Materiales". null = todavía no se reordenó (va al final, por id). Se reasigna 0..n-1 sobre TODOS los pedidos activos cada vez que se reordena.

  // Recursos que manda el CLIENTE para poder hacer el diseño (logo,
  // referencias, arte previo). Es opcional y lo carga Recepción en el alta.
  // NO es la hoja de autorización: esa es el montaje que sube Diseño en cada
  // ronda (ver `DesignRevision`). Ver WORKFLOW.md §1.
  clientResourceFileData String? // Contenido en base64 (sin prefijo data:) del archivo que mandó el cliente. Legacy: null si el archivo está en el almacenamiento de objetos (ver clientResourceFileKey).
  clientResourceFileKey  String? // Clave del objeto en el almacenamiento externo (R2/S3) cuando STORAGE_DRIVER=s3. Si está, manda sobre clientResourceFileData (ver src/storage).
  clientResourceFileName String? // Nombre de archivo original del archivo del cliente.
  clientResourceFileMime String? // Mime type del archivo del cliente (image/png, image/jpeg, application/pdf).

  client             Client?             @relation(fields: [clientId], references: [id]) // Relación con Client (opcional).
  user               User                @relation(fields: [userId], references: [id]) // Relación con User (creador).
  assignedUser       User?               @relation("AssignedOrders", fields: [assignedUserId], references: [id]) // Relación con User asignado.
  attendedBy         User?               @relation("AttendedOrders", fields: [attendedByUserId], references: [id]) // Relación con la recepcionista que atiende el pedido.
  status             Status              @relation(fields: [statusId], references: [id]) // Relación con Status.
  histories          OrderHistory[] // Relación uno a muchos con OrderHistory.
  orderProducts      OrderProduct[] // Líneas de producto del pedido.
  notes              OrderNote[] // Notas/comentarios internos sobre el pedido.
  auditLogs          OrderAuditLog[] // Auditoría de ediciones del pedido.
  notifications      Notification[] // Notificaciones persistentes que referencian este pedido.
  designRevisions    DesignRevision[] // Rondas de montaje/feedback/autorización de la fase de Diseño.
  chatMessages       ChatMessage[] // Mensajes del chat interno que referencian este pedido como contexto.
  areaTasks          OrderAreaTask[] // Trabajo de producción por área; varias áreas avanzan en paralelo (ver WORKFLOW.md §3).
  calendarTasks      CalendarTask[] // Tareas pendientes del calendario de equipo vinculadas a este pedido (opcional, ej. "confirmar medidas").
  calendarEvents     CalendarEvent[] // Eventos del calendario de equipo vinculados a este pedido (instalación, compra de materiales, etc.).
  materialItems      OrderMaterialItem[] // Hoja de materiales del pedido: qué se va a usar en producción (opcional, la carga Recepción).
  inventoryMovements InventoryMovement[] // Consumos de inventario imputados a este pedido (opcional).
  mockups            OrderMockup[] // Mockups 3D (playera/gorra con los diseños del cliente) adjuntados al pedido.
  quote              Quote? // Cotización aceptada que se convirtió en este pedido (si vino de una).
  branch             Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull) // Sucursal de origen (si vino de una).
  branchEmployee     BranchEmployee?     @relation(fields: [branchEmployeeId], references: [id], onDelete: SetNull) // Empleado de la sucursal que lo levantó.

  @@index([statusId])
  @@index([clientId])
  @@index([userId])
  @@index([assignedUserId])
  @@index([attendedByUserId])
  @@index([deliveryDate])
  @@index([creationDate])
  @@index([area])
  @@index([materialsPriority])
  @@index([branchId])
}

model DesignRevision {
  id      Int @id @default(autoincrement()) // Identificador único de la ronda de diseño.
  orderId Int // Clave foránea que referencia a Order.
  round   Int // Número de ronda dentro del pedido: 1, 2, 3... (max(round)+1 al crear).

  // Montaje enviado por Diseño (imagen/PDF), una versión por ronda.
  montageFileData String? // Contenido en base64 (sin prefijo data:) del montaje. Legacy: null si está en el almacenamiento de objetos.
  montageFileKey  String? // Clave del objeto (R2/S3) del montaje. Comparte el objeto con el primer DesignRevisionFile 'montage' de la ronda.
  montageFileName String? // Nombre de archivo original del montaje.
  montageFileMime String? // Mime type del montaje (image/png, image/jpeg, application/pdf).
  sentAt          DateTime? // Fecha en que Diseño envió el montaje.
  sentByUserId    Int? // Clave foránea que referencia al User (diseñador) que envió el montaje.

  // Feedback del cliente, cargado por Recepción.
  feedbackText     String? // Texto del feedback del cliente (máx. 2000 caracteres, validado en el DTO).
  feedbackFileData String? // Contenido en base64 (sin prefijo data:) del adjunto de feedback. Legacy: null si está en el almacenamiento de objetos.
  feedbackFileKey  String? // Clave del objeto (R2/S3) del adjunto de feedback. Comparte el objeto con el primer DesignRevisionFile 'feedback' de la ronda.
  feedbackFileName String? // Nombre de archivo original del adjunto de feedback.
  feedbackFileMime String? // Mime type del adjunto de feedback.
  feedbackAt       DateTime? // Fecha en que Recepción cargó el feedback.
  feedbackByUserId Int? // Clave foránea que referencia al User (Recepción) que cargó el feedback.

  // Resolución: el cliente autorizó esta ronda.
  approved         Boolean   @default(false) // Si el cliente autorizó esta ronda de montaje.
  approvedAt       DateTime? // Fecha de autorización.
  approvedByUserId Int? // Clave foránea que referencia al User (Recepción) que marcó la autorización.

  createdAt DateTime @default(now()) // Fecha de creación de la ronda.

  order          Order                @relation(fields: [orderId], references: [id], onDelete: Cascade) // Relación con Order (se borra en cascada si se borra el pedido).
  sentByUser     User?                @relation("DesignRevisionSentBy", fields: [sentByUserId], references: [id]) // Relación con User que envió el montaje.
  feedbackByUser User?                @relation("DesignRevisionFeedbackBy", fields: [feedbackByUserId], references: [id]) // Relación con User que cargó el feedback.
  approvedByUser User?                @relation("DesignRevisionApprovedBy", fields: [approvedByUserId], references: [id]) // Relación con User que autorizó.
  files          DesignRevisionFile[] // Archivos de la ronda (montaje y/o feedback); una ronda admite varios (WORKFLOW.md §2).

  @@index([orderId])
  @@index([orderId, round])
}

/// Archivo adjunto de una ronda de diseño. Una ronda puede llevar VARIAS
/// imágenes o un PDF, tanto en el montaje que manda Diseño como en el feedback
/// que carga Recepción (WORKFLOW.md §2).
///
/// Los campos escalares `montageFile*`/`feedbackFile*` de `DesignRevision` se
/// siguen poblando con el PRIMER archivo de cada tipo, para no romper a los
/// clientes viejos que sólo conocen un archivo por ronda.
model DesignRevisionFile {
  id         Int      @id @default(autoincrement()) // Identificador único del archivo.
  revisionId Int // Clave foránea que referencia a DesignRevision.
  kind       String // Para qué lado de la ronda es: 'montage' | 'feedback'.
  data       String? // Contenido en base64 (sin prefijo data:). Legacy: null si está en el almacenamiento de objetos (ver dataKey).
  dataKey    String? // Clave del objeto en el almacenamiento externo (R2/S3). Si está, manda sobre `data`.
  filename   String // Nombre de archivo original.
  mimeType   String // Mime type real del archivo (image/png, image/jpeg, application/pdf).
  position   Int      @default(0) // Orden de visualización dentro de la ronda.
  createdAt  DateTime @default(now()) // Fecha de carga del archivo.

  revision DesignRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade) // Relación con la ronda (se borra en cascada).

  @@index([revisionId])
  @@index([revisionId, kind])
}

model OrderNote {
  id        Int      @id @default(autoincrement()) // Identificador único de la nota.
  orderId   Int // Clave foránea que referencia a Order.
  userId    Int // Clave foránea que referencia al User autor de la nota.
  text      String // Contenido de la nota (máx. 2000 caracteres, validado en el DTO).
  createdAt DateTime @default(now()) // Fecha de creación de la nota.

  order Order @relation(fields: [orderId], references: [id]) // Relación con Order.
  user  User  @relation(fields: [userId], references: [id]) // Relación con User autor.

  @@index([orderId])
  @@index([userId])
}

model OrderAuditLog {
  id        Int      @id @default(autoincrement()) // Identificador único del registro de auditoría.
  orderId   Int // Clave foránea que referencia a Order.
  userId    Int // Clave foránea que referencia al User que realizó la acción.
  action    String // Acción realizada: "created" | "updated" | etc.
  changes   Json // Diff de campos: { campo: { before, after } }.
  createdAt DateTime @default(now()) // Fecha del registro de auditoría.

  order Order @relation(fields: [orderId], references: [id]) // Relación con Order.
  user  User  @relation(fields: [userId], references: [id]) // Relación con User que hizo el cambio.

  @@index([orderId])
  @@index([userId])
}

model OrderHistory {
  id               Int      @id @default(autoincrement()) // Identificador único del registro de historial de la orden.
  orderId          Int // Clave foránea que referencia a Order.
  previousStatusId Int // Clave foránea que referencia al estado anterior en Status.
  newStatusId      Int // Clave foránea que referencia al nuevo estado en Status.
  changeDate       DateTime @default(now()) // Fecha y hora en que ocurrió el cambio de estado.

  order          Order  @relation(fields: [orderId], references: [id]) // Relación con Order.
  previousStatus Status @relation("PreviousStatus", fields: [previousStatusId], references: [id]) // Relación con el estado anterior en Status.
  newStatus      Status @relation("NewStatus", fields: [newStatusId], references: [id]) // Relación con el nuevo estado en Status.

  @@index([orderId])
  @@index([changeDate])
  @@index([previousStatusId])
  @@index([newStatusId])
}

/// Estado de una tarea de área. Independiente de `Status` (el estado global del
/// pedido): acá el ciclo es corto y siempre el mismo, sin importar el área.
enum AreaTaskStatus {
  pendiente
  en_proceso
  terminado
}

/// Trabajo que le toca a UN área dentro de un pedido.
///
/// Un pedido puede necesitar varias áreas (ej. bordado + dtf) y todas trabajan
/// EN PARALELO: cada una lleva su propio estado y su propio responsable, sin
/// esperar a las demás. Cuando todas quedan en `terminado`, el pedido pasa solo
/// a "listo para entregar"; la entrega la confirma Recepción a mano.
/// Ver WORKFLOW.md §3.
model OrderAreaTask {
  id             Int            @id @default(autoincrement())
  orderId        Int // Pedido al que pertenece esta tarea.
  area           String // Área que la trabaja: taller | dtf | bordado | laser | impresiones (nunca 'diseno').
  status         AreaTaskStatus @default(pendiente) // Avance de esta área en particular.
  assignedUserId Int? // Responsable. Por defecto la cuenta compartida del área; alguien del área puede tomarla.
  createdAt      DateTime       @default(now())
  startedAt      DateTime? // Cuándo pasó a en_proceso.
  completedAt    DateTime? // Cuándo pasó a terminado.

  order        Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignedUser User?            @relation("AssignedAreaTasks", fields: [assignedUserId], references: [id])
  supply       OrderAreaSupply? // Hoja de materiales del área: de dónde salen los insumos (ver WORKFLOW.md §3).

  // Un área no puede aparecer dos veces en el mismo pedido.
  @@unique([orderId, area])
  @@index([orderId])
  @@index([area])
  @@index([assignedUserId])
  @@index([status])
}

/// El catálogo de productos y el inventario (ProductType, Color, Size, Product,
/// InventoryTransaction) se retiraron: existían en la base y en la API pero
/// nunca tuvieron interfaz, y los pedidos siempre guardaron el producto como
/// texto libre (`OrderProduct.customName`), así que ningún pedido descontaba
/// stock. Al retirarlos las cinco tablas estaban vacías y ninguna línea de
/// pedido referenciaba un producto. Ver la migración
/// 20260907220000_remove_inventory.

model OrderProduct {
  id         Int    @id @default(autoincrement()) // Identificador único de la línea de producto del pedido.
  orderId    Int // Clave foránea que referencia a Order.
  customName String // Nombre del producto, escrito a mano o elegido de OrderProductPreset.
  quantity   Int // Cantidad del producto en la orden.
  sizes      Json? // Desglose de tallas de prendas: { general?: {S:5,…}, mujer?: {…}, youth?: {…} } (src/common/garment-sizes.ts). null = sin tallas. Si existe, su total = quantity.

  order Order @relation(fields: [orderId], references: [id]) // Relación con Order.

  @@index([orderId])
}

model OrderProductPreset {
  id   Int    @id @default(autoincrement()) // Identificador único del preset.
  name String @unique // Nombre del producto frecuente (ej. "Lona", "X-Banner").
}

/// Calendario de equipo de Recepción: reemplaza la lista de tareas por
/// WhatsApp (instalaciones, juntas, visitas a clientes) por eventos con
/// fecha/hora, compartidos por todo el equipo (recepcion/admin/superuser
/// pueden ver y editar cualquier evento, no sólo el propio). Reusa
/// `AreaTaskStatus` (pendiente → en_proceso → terminado) para el mismo ciclo
/// de "❌ / 🟠 / ✅" que ya usaban a mano.
/// Categoría de un evento del calendario, para diferenciar de un vistazo
/// instalaciones/visitas/entregas (que sí llevan seguimiento de estado) de
/// juntas (que son sólo informativas: una junta no tiene "pendiente" o
/// "terminado", sólo pasa o no pasa). Qué categorías llevan seguimiento de
/// estado es una decisión de UI (ver CATEGORY_META en el frontend), no algo
/// que valide este enum.
enum CalendarEventCategory {
  instalacion
  visita
  entrega
  junta
  // Evento auto-generado ("Compra de materiales") una semana antes de la
  // entrega/instalación de un pedido — ver OrderMaterialItemService y
  // CalendarEventService.
  compras
  otro
}

model CalendarEvent {
  id         Int                   @id @default(autoincrement())
  title      String // Qué hay que hacer (ej. "Instalar anuncio", "Visita a planta").
  clientName String? // Cliente/empresa escrito a mano, igual que hoy en WhatsApp.
  clientId   Int? // Cliente real vinculado, opcional (combobox "usar como texto libre" u elegir de la lista).
  orderId    Int? // Pedido vinculado, opcional. En categoría "compras" es lo que arma el checklist de materiales.
  category   CalendarEventCategory @default(otro) // Color/naturaleza del evento en el calendario de equipo.
  area       String? // Área de producción involucrada (uno de ORDER_AREAS), opcional — filtro adicional del calendario, independiente de `category`.

  eventDate DateTime // Fecha (y hora, si `hasTime`) del evento.
  hasTime   Boolean  @default(true) // Si `eventDate` lleva una hora real; si es false, es un evento "todo el día" y la hora se ignora.

  status AreaTaskStatus @default(pendiente) // pendiente | en_proceso | terminado. Categorías sin seguimiento (ej. junta) simplemente no lo muestran en la UI.

  // Recordatorio push: además del aviso fijo 1h antes (ver
  // CalendarEventReminderService), el usuario puede pedir uno con más
  // anticipación (minutos/horas/días/semanas antes, guardado en minutos).
  reminderMinutesBefore Int?
  reminderSentAt        DateTime? // Cuándo se mandó el recordatorio con anticipación custom (evita reenviarlo).
  finalReminderSentAt   DateTime? // Cuándo se mandó el aviso fijo de 1h antes (evita reenviarlo).

  createdById Int
  createdAt   DateTime @default(now())

  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy User    @relation("CalendarEventCreatedBy", fields: [createdById], references: [id])

  @@index([eventDate])
  @@index([clientId])
  @@index([orderId])
  @@index([createdById])
  @@index([status])
  @@index([area])
}

/// Lista de tareas pendientes del calendario de equipo: actividades sin
/// fecha todavía definida (ej. "Confirmar medidas con cliente"), separadas
/// conceptualmente de `CalendarEvent` (que sí tiene fecha/hora). Mismo
/// equipo/visibilidad que el calendario (recepcion/admin/superuser), sin
/// asignación a una persona en particular.
model CalendarTask {
  id          Int       @id @default(autoincrement())
  title       String // Qué hay que hacer (ej. "Confirmar medidas con cliente").
  description String? // Detalle opcional.
  completed   Boolean   @default(false)
  completedAt DateTime? // Cuándo se marcó como completada (null si sigue pendiente).

  orderId Int? // Pedido relacionado, opcional (ej. "confirmar medidas" de un pedido puntual). Si el pedido se borra, la tarea sigue existiendo sin vínculo.

  createdById Int
  createdAt   DateTime @default(now())

  order     Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy User   @relation("CalendarTaskCreatedBy", fields: [createdById], references: [id])

  @@index([completed])
  @@index([createdById])
  @@index([orderId])
}

model AreaVisibilitySetting {
  id                 Int     @id @default(autoincrement()) // Identificador único de la configuración.
  role               String  @unique // Rol operativo ('taller' | 'dtf' | 'bordado' | 'diseno' | 'laser' | 'impresiones').
  generalViewEnabled Boolean @default(true) // Si es true, todos los usuarios del rol ven todos los pedidos de su etapa; si es false, solo ven los pedidos sin asignar o asignados a ellos mismos.
}

model AppSetting {
  id                      Int @id @default(1) // Fila única de configuración global (siempre id=1).
  deliveredRetentionHours Int @default(48) // Horas que un pedido "entregado" sigue visible en el tablero en vivo.
}

model Notification {
  id        Int      @id @default(autoincrement()) // Identificador único de la notificación.
  userId    Int // Clave foránea que referencia al User destinatario.
  type      String // Tipo de notificación (ej. "order_assigned", "order_status_changed"), abierto a futuros tipos.
  title     String // Título corto de la notificación.
  body      String? // Cuerpo/detalle opcional de la notificación.
  orderId   Int? // Clave foránea opcional que referencia a Order, para poder linkear "ver pedido".
  read      Boolean  @default(false) // Si el usuario ya la marcó como leída.
  createdAt DateTime @default(now()) // Fecha de creación de la notificación.

  user  User   @relation(fields: [userId], references: [id]) // Relación con User destinatario.
  order Order? @relation(fields: [orderId], references: [id]) // Relación opcional con Order.

  @@index([userId, read])
  @@index([orderId])
}

model PushSubscription {
  id        Int      @id @default(autoincrement()) // Identificador único de la suscripción push.
  userId    Int // Clave foránea que referencia al User dueño de la suscripción.
  endpoint  String   @unique // URL del endpoint del navegador (identifica la suscripción unívocamente).
  p256dh    String // Clave pública de cifrado (ECDH P-256) que manda el navegador.
  auth      String // Secreto de autenticación que manda el navegador.
  createdAt DateTime @default(now()) // Fecha de creación de la suscripción.

  user User @relation(fields: [userId], references: [id]) // Relación con User dueño.

  @@index([userId])
}

model ExpoPushToken {
  id        Int      @id @default(autoincrement()) // Identificador único del token.
  userId    Int // Clave foránea que referencia al User dueño del token.
  token     String   @unique // Token de push de Expo (ExponentPushToken[...]), resuelve a FCM/APNs.
  createdAt DateTime @default(now()) // Fecha de registro del token.

  user User @relation(fields: [userId], references: [id]) // Relación con User dueño.

  @@index([userId])
}

model Log {
  id      Int      @id @default(autoincrement()) // Identificador único del registro.
  userId  Int // Clave foránea que referencia a User.
  logDate DateTime @default(now()) // Fecha y hora en que se registró la acción.
  action  String // Descripción de la acción realizada.

  user User @relation(fields: [userId], references: [id]) // Relación con User.

  @@index([userId])
  @@index([logDate])
}

/// Conversación del chat interno. Dos tipos:
/// - `area`: canal fijo Recepción ↔ un área operativa (uno por área, `area` único).
/// - `direct`: mensaje directo 1 a 1 entre dos usuarios (`directUserAId` < `directUserBId`).
/// La membresía se deriva SIEMPRE de estas columnas + los roles del usuario
/// (ver ChatService.assertConversationAccess); `ChatConversationMember` es un
/// cache de la membresía para poder guardar el marcador de leídos.
model ChatConversation {
  id            Int       @id @default(autoincrement()) // Identificador único de la conversación.
  type          String // 'area' | 'direct'.
  area          String?   @unique // Área operativa del canal (sólo para type='area'): taller | dtf | bordado | diseno | laser | impresiones.
  directUserAId Int? // Primer participante del DM (el de id menor), sólo para type='direct'.
  directUserBId Int? // Segundo participante del DM (el de id mayor), sólo para type='direct'.
  directKey     String?   @unique // Clave canónica "menorId:mayorId" para garantizar un único DM por par de usuarios.
  createdAt     DateTime  @default(now()) // Fecha de creación de la conversación.
  lastMessageAt DateTime? // Fecha del último mensaje, para ordenar la lista de conversaciones.

  directUserA User? @relation("ChatDirectUserA", fields: [directUserAId], references: [id])
  directUserB User? @relation("ChatDirectUserB", fields: [directUserBId], references: [id])

  members  ChatConversationMember[] // Membresías materializadas (marcador de leídos).
  messages ChatMessage[] // Mensajes de la conversación.

  @@index([type])
  @@index([lastMessageAt])
}

/// Membresía materializada de un usuario en una conversación. NO es la fuente
/// de verdad de la autorización (eso lo resuelve ChatService a partir de los
/// roles): existe para persistir `lastReadAt` (badge de no leídos) y para
/// poder mostrar la lista de participantes, marcando a los admin como
/// monitores.
model ChatConversationMember {
  id             Int       @id @default(autoincrement()) // Identificador único de la membresía.
  conversationId Int // Clave foránea que referencia a ChatConversation.
  userId         Int // Clave foránea que referencia al User miembro.
  isMonitor      Boolean   @default(false) // true para admin/superuser: participan para monitoreo, visible en la lista de participantes.
  lastReadAt     DateTime? // Fecha del último mensaje leído por este usuario en la conversación.
  deliveredAt    DateTime? // Última vez que el cliente de este usuario confirmó tener la conexión viva (usado para el check "entregado" — ver NotificationsGateway).
  joinedAt       DateTime  @default(now()) // Fecha en que se materializó la membresía.

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
}

/// Mensaje de chat persistido. La entrega en vivo va por WebSocket
/// (NotificationsGateway.emitChatMessage), igual que las notificaciones:
/// se persiste y además se emite, para que el historial sobreviva al reload.
model ChatMessage {
  id                 Int      @id @default(autoincrement()) // Identificador único del mensaje.
  conversationId     Int // Clave foránea que referencia a ChatConversation.
  senderId           Int // Clave foránea que referencia al User que lo envió.
  body               String? // Contenido del mensaje (texto plano). Opcional si hay adjunto.
  // Referencia opcional a un pedido, para dar contexto sin que sea
  // obligatorio en cada mensaje (ej. "che, mirá el pedido #123"). `SetNull`
  // en vez de `Cascade`: si el pedido se borra, el mensaje sobrevive sin la
  // referencia en lugar de desaparecer.
  orderId            Int?
  // Adjunto opcional (foto, documento o audio). Mismo esquema que
  // Order.clientResourceFile*: el contenido va en base64 en la columna
  // (legacy, STORAGE_DRIVER=db) o en R2/S3 con su clave en `attachmentKey`
  // (STORAGE_DRIVER=s3, ver src/storage), y el tipo/tamaño se validan en
  // ChatService.sendMessage (magic-byte sniffing con `file-type`, igual que
  // OrderService.assertOrderFileValid).
  attachmentData     String? // Legacy: null si el adjunto está en el almacenamiento de objetos (ver attachmentKey).
  attachmentKey      String? // Clave del objeto en el almacenamiento externo (R2/S3). Si está, manda sobre attachmentData.
  attachmentFilename String?
  attachmentMimeType String?
  attachmentSize     Int?
  createdAt          DateTime @default(now()) // Fecha de envío.

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [senderId], references: [id])
  order        Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([orderId])
}

// Log de auditoría genérico (independiente de `OrderAuditLog`, que sólo
// cubre cambios de campos de un pedido puntual). Pensado para eventos que no
// tienen necesariamente un `orderId` (ej. exportación CSV de varios pedidos)
// o que agrupan varias entidades (ej. una acción masiva). Sin relación FK a
// `User`/`Order`: así el registro sobrevive aunque se borre el actor o la
// entidad referenciada, y no exige que `entityId` sea siempre un id de
// pedido.
model AuditLog {
  id          Int      @id @default(autoincrement()) // Identificador único del registro.
  actorUserId Int // Id del usuario que ejecutó la acción (sin FK, ver nota arriba).
  action      String // Acción realizada: "order.bulk_status_update" | "order.csv_export" | etc.
  entityType  String // Tipo de entidad afectada: "order" | "order_bulk" | "order_export" | etc.
  entityId    String // Id (o ids serializados/"bulk") de la entidad afectada.
  metadata    Json? // Detalle adicional de la acción (ids afectados, filtros usados, resultado, etc.).
  createdAt   DateTime @default(now()) // Fecha del registro.

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
}

/// Categoría de material (ej. "Lámina/Panel", "Perfil metálico"): catálogo
/// que arranca con valores sembrados (ver seed.ts) y crece solo cuando se
/// escribe un nombre nuevo al dar de alta un Material (mismo patrón que
/// OrderProductPreset con los productos de un pedido).
model MaterialCategory {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  materials Material[]
}

/// Unidad de medida de un material (ej. "Hoja", "Metro", "Kilogramo"):
/// mismo patrón de catálogo que crece solo que MaterialCategory.
model MaterialUnit {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  materials Material[]
}

/// Proveedor de materiales/insumos. `location` clasifica el alcance
/// (nacional/local/internacional) — la hoja de materiales de un pedido lee
/// esta ubicación EN VIVO desde acá, no guarda una copia.
model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  website   String?
  location  String // "nacional" | "local" | "internacional"
  createdAt DateTime @default(now())

  materials              Material[]
  orderMaterialItems     OrderMaterialItem[]
  inventoryItems         InventoryItem[]
  orderTemplateMaterials OrderTemplateMaterial[]

  @@index([location])
}

/// Catálogo de materiales/insumos de la empresa (PVC, acrílico, MDF,
/// perfiles metálicos, tornillería, consumibles de DTF/Bordado, etc.).
/// `measure` es texto libre porque el "grosor"/"calibre"/"medida" varía
/// demasiado entre tipos de material como para modelarlo con un tipo
/// estructurado único. `areas` es un array nativo de Postgres: un material
/// puede usarse en varias áreas de producción a la vez (ver ORDER_AREAS).
model Material {
  id             Int      @id @default(autoincrement())
  name           String // "PVC", "Acrílico", "MDF", "Epanel", "Hilo de bordado", "Film DTF"...
  categoryId     Int?
  unitId         Int?
  measure        String? // "6mm", "3/16 x 1 1/4", texto libre.
  color          String?
  brand          String?
  supplierId     Int? // Proveedor preferido, opcional — la hoja de materiales de un pedido puede usar otro.
  areas          String[] // Subconjunto de ORDER_AREAS (taller/dtf/bordado/diseno/laser/impresiones).
  // Precio de referencia del material, en pesos mexicanos. Al agregar una
  // línea a la hoja de materiales de un pedido se copia acá (ver
  // OrderMaterialItem.price); si se edita después, se propaga a las líneas
  // de pedidos no entregados que usan este material.
  suggestedPrice Decimal? @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  category MaterialCategory? @relation(fields: [categoryId], references: [id])
  unit     MaterialUnit?     @relation(fields: [unitId], references: [id])
  supplier Supplier?         @relation(fields: [supplierId], references: [id])

  orderMaterialItems     OrderMaterialItem[]
  orderTemplateMaterials OrderTemplateMaterial[] // Líneas de plantillas de pedido que usan este material.
  inventoryItems         InventoryItem[] // Existencias físicas de este material en los departamentos (un material puede no estar inventariado).

  @@index([categoryId])
  @@index([unitId])
  @@index([supplierId])
}

/// Línea de la hoja de materiales de un pedido: qué material, cuánto, de
/// dónde sale y a nombre de quién queda. La carga Recepción cuando el
/// pedido pasa a producción (opcional, no bloquea la autorización del
/// montaje). `description` se autogenera desde el Material elegido pero es
/// editable, así que queda copiada acá (no se recalcula si el material
/// cambia después).
/// `price` se copia del `Material.suggestedPrice` al agregar la línea y se
/// mantiene sincronizado mientras el pedido no esté entregado: si cambia el
/// precio sugerido del material, se propaga a todas las líneas de pedidos no
/// entregados que lo usan (ver `MaterialService.update`). Al entregarse el
/// pedido, el precio de sus líneas queda congelado para siempre (ver
/// `OrderService` — el cambio de estado a "entregado" es el que congela).
/// `purchased` es el checklist del evento de calendario "Compra de
/// materiales": si ya se compró esta línea.
model OrderMaterialItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  materialId  Int
  quantity    Int
  description String
  supplierId  Int? // Puede diferir del proveedor preferido del material.
  price       Decimal  @default(0) @db.Decimal(10, 2)
  purchased   Boolean  @default(false)
  createdById Int
  createdAt   DateTime @default(now())

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  material  Material  @relation(fields: [materialId], references: [id])
  supplier  Supplier? @relation(fields: [supplierId], references: [id])
  createdBy User      @relation("OrderMaterialItemCreatedBy", fields: [createdById], references: [id])

  @@index([orderId])
  @@index([materialId])
}

// ─── Inventario por departamento ────────────────────────────────────────────
//
// NO es lo mismo que el catálogo de Materiales. `Material` es la lista de
// insumos con la que se arma la hoja de materiales de un pedido (qué hay que
// comprar para ese trabajo). `InventoryItem` son las EXISTENCIAS físicas que
// cada departamento tiene en su estante: incluye materiales del catálogo
// (vinculados por `materialId`) y también consumibles que nunca van a una
// hoja de materiales — conos de hilo de bordado, tintas de impresión,
// estabilizador, refacciones, etc.

enum InventoryMovementType {
  ENTRADA // Compra/reposición: suma stock.
  SALIDA // Consumo/merma: resta stock (no puede dejarlo negativo).
  AJUSTE // Conteo físico: fija el stock al valor contado; se guarda la diferencia.
}

model InventoryItem {
  id         Int      @id @default(autoincrement())
  area       String // Departamento dueño de la existencia: uno de INVENTORY_AREAS (taller/dtf/bordado/diseno/laser/impresiones/recepcion).
  name       String // "Hilo poliéster 40 rojo", "Tinta Eco-Solvente Cyan".
  sku        String? // Código interno o del fabricante (ej. "MAD-1147"). Único por departamento.
  barcode    String?  @unique // Código de barras Code 128 de la etiqueta, único en todo el inventario. Por omisión "EMD-" + id con 6 ceros (EMD-000123); también puede ligarse el EAN/UPC del fabricante.
  category   String? // Texto libre: "Hilos", "Tintas", "Estabilizador", "Refacciones"...
  unit       String // Unidad en que se cuenta: "cono", "rollo", "litro", "pieza"...
  color      String?
  brand      String?
  location   String? // Ubicación física: "Estante A-3", "Cajón 2".
  quantity   Decimal  @default(0) @db.Decimal(12, 3) // Stock actual. Sólo cambia vía InventoryMovement (kardex).
  minStock   Decimal? @db.Decimal(12, 3) // Punto de reorden: con quantity <= minStock el artículo está "bajo stock".
  unitCost   Decimal? @db.Decimal(10, 2) // Costo unitario de referencia en MXN, para valuar el inventario.
  notes      String?
  materialId Int? // Vínculo opcional con el catálogo de Materiales.
  supplierId Int? // Proveedor habitual de reposición.
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  material        Material?             @relation(fields: [materialId], references: [id], onDelete: SetNull)
  supplier        Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements       InventoryMovement[]
  supplyLines     OrderAreaSupplyLine[] // Líneas de hojas de materiales que apartan este artículo.
  restockRequests RestockRequest[]

  @@unique([area, sku])
  @@index([area])
  @@index([materialId])
  @@index([supplierId])
}

model InventoryMovement {
  id            Int                   @id @default(autoincrement())
  itemId        Int
  type          InventoryMovementType
  delta         Decimal               @db.Decimal(12, 3) // Cambio con signo aplicado al stock (+ entrada, - salida, ± ajuste).
  balanceAfter  Decimal               @db.Decimal(12, 3) // Stock resultante, para leer el kardex sin recalcular.
  unitCost      Decimal?              @db.Decimal(10, 2) // Costo unitario de esta entrada (si se informó).
  note          String?
  orderId       Int? // Pedido al que se imputa el consumo (opcional).
  areaTaskId    Int? // Tarea de área cuyo "terminado" generó el movimiento (descuento automático de la hoja de materiales).
  createdById   Int // Quién registró el movimiento (bitácora).
  balanceBefore Decimal?              @db.Decimal(12, 3) // Stock antes del movimiento (bitácora: antes/después). Null en movimientos previos a la bitácora.
  area          String? // Departamento del artículo al momento del movimiento (la bitácora no cambia si luego se reasigna).
  reason        String? // Motivo capturado ("Se trajo directo al área", "Consumo pedido 123"...).
  source        String? // Origen: "recepcion" (gestión), "area" (usuario de producción), "scan" (escáner), "inicial" (stock inicial).
  createdAt     DateTime              @default(now())

  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  order     Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy User          @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id])

  @@index([itemId, createdAt])
  @@index([orderId])
  @@index([areaTaskId])
  @@index([createdAt])
  @@index([area, createdAt])
  @@index([createdById, createdAt])
}

enum RestockRequestStatus {
  PENDIENTE // Recién avisada por el área; Recepción no la ha atendido.
  EN_CAMINO // Recepción ya pidió el insumo y viene en camino.
  COMPRADO // Ya se compró; falta entregarlo/darle entrada.
  RESUELTO // Entregado o descartado: cierra la solicitud.
}

enum RestockRequestUrgency {
  NORMAL
  URGENTE
}

// Aviso de "se acabó / requiere reabasto" que un área de producción levanta
// para Recepción. Puede apuntar a un artículo del inventario del área o ser
// texto libre (insumo que todavía no está dado de alta).
model RestockRequest {
  id            Int                   @id @default(autoincrement())
  area          String // Departamento que pide (uno de INVENTORY_AREAS).
  itemId        Int? // Artículo del inventario, si se eligió uno.
  itemName      String // Nombre del insumo (copia del artículo o texto libre).
  quantity      Decimal?              @db.Decimal(12, 3) // Cantidad sugerida (opcional).
  unit          String?
  comment       String?
  urgency       RestockRequestUrgency @default(NORMAL)
  status        RestockRequestStatus  @default(PENDIENTE)
  statusNote    String? // Nota de Recepción al cambiar el estado ("Llega el jueves").
  requestedById Int
  handledById   Int? // Último usuario de Recepción/admin que cambió el estado.
  resolvedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  item        InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  requestedBy User           @relation("RestockRequestRequestedBy", fields: [requestedById], references: [id])
  handledBy   User?          @relation("RestockRequestHandledBy", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([area, createdAt])
  @@index([itemId])
}

// ─── Hoja de materiales por área (origen de insumos) ───────────────────────
//
// Se captura cuando Recepción marca que el cliente autorizó el montaje: por
// cada tarea de área del pedido se indica si los insumos los trae el cliente
// o los ponemos nosotros. Los "nuestros" ligados a inventario quedan
// APARTADOS al guardar y se DESCUENTAN (SALIDA) cuando el área marca su tarea
// como terminada; si la tarea regresa de terminado se devuelven (ENTRADA).

enum SupplySource {
  cliente // Lo trae el cliente: nunca toca inventario.
  nosotros // Lo ponemos nosotros: sale del inventario del taller.
}

model OrderAreaSupply {
  id          Int          @id @default(autoincrement())
  areaTaskId  Int          @unique
  source      SupplySource
  createdById Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  areaTask OrderAreaTask         @relation(fields: [areaTaskId], references: [id], onDelete: Cascade)
  lines    OrderAreaSupplyLine[]
}

model OrderAreaSupplyLine {
  id              Int       @id @default(autoincrement())
  supplyId        Int
  inventoryItemId Int? // Sólo en origen "nosotros"; null = línea de texto libre (no está en inventario).
  description     String // "12 playeras negras del cliente", "Film DTF".
  quantity        Decimal   @db.Decimal(12, 3)
  discountedAt    DateTime? // Cuándo se descontó del stock (null = apartado / sin descontar).

  supply        OrderAreaSupply @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem?  @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([supplyId])
  @@index([inventoryItemId])
}

// ─── Plantillas de pedido por cliente ──────────────────────────────────────
//
// Lo que un cliente suele pedir, guardado con nombre ("Figuras de
// coroplast"): productos y cantidades, descripción base, ruta de
// diseño/producción y hoja de materiales. Recepción la elige al dar de alta
// un pedido y el formulario se precarga (siempre editable). NO guarda fecha
// de entrega ni archivo del cliente: cambian en cada pedido. Tampoco a quién
// se asigna: la gente rota, se elige en el alta.

model OrderTemplate {
  id              Int       @id @default(autoincrement())
  clientId        Int
  name            String // Nombre visible, único por cliente.
  requiresDesign  Boolean   @default(true)
  productionAreas String[] // Áreas de producción (PRODUCTION_AREAS), la principal primero.
  description     String    @default("") // Descripción base; puede quedar vacía.
  useCount        Int       @default(0) // Pedidos creados con esta plantilla (ordena las más usadas primero).
  lastUsedAt      DateTime?
  createdById     Int? // Quién la guardó; queda en null si se borra el usuario.
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client    Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User?                   @relation("OrderTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  products  OrderTemplateProduct[]
  materials OrderTemplateMaterial[]

  @@unique([clientId, name])
  @@index([clientId])
}

model OrderTemplateProduct {
  id         Int    @id @default(autoincrement())
  templateId Int
  position   Int // Orden en el que se muestran/copian las líneas.
  customName String
  quantity   Int

  template OrderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model OrderTemplateMaterial {
  id          Int    @id @default(autoincrement())
  templateId  Int
  position    Int
  materialId  Int
  quantity    Int
  description String
  supplierId  Int?

  template OrderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  // Borrar un material del catálogo no debe quedar bloqueado por una plantilla.
  material Material      @relation(fields: [materialId], references: [id], onDelete: Cascade)
  supplier Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@index([materialId])
}

// ─── Aprendizaje por cliente ───────────────────────────────────────────────
//
// Perfil de hábitos que el sistema aprende del historial de pedidos de cada
// cliente (ver ClientInsightService y client-insight.engine.ts): qué suele
// pedir y cuánto, por dónde va (diseño/áreas), qué materiales lleva, con
// cuánta anticipación y cada cuánto pide. Se recalcula cada vez que se crea
// o borra un pedido del cliente o cambia su hoja de materiales. `profile`
// guarda el resultado completo; `nextExpectedAt` queda en columna para
// listar rápido "clientes que suelen pedir por estas fechas".

model ClientInsight {
  clientId       Int       @id
  version        Int // ENGINE_VERSION con el que se calculó (otra versión -> se recalcula).
  ordersAnalyzed Int
  lastOrderAt    DateTime?
  nextExpectedAt DateTime? // Fecha estimada del próximo pedido según su cadencia (null si no es predecible).
  cadenceRegular Boolean   @default(false) // Los intervalos entre pedidos son parecidos entre sí.
  profile        Json
  updatedAt      DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([nextExpectedAt])
}

// ─── Mockups 3D ─────────────────────────────────────────────────────────────
//
// Lámina PNG/JPEG que arma Recepción en el creador de mockups 3D (playera
// Gildan 5000 o gorra trucker Richardson 112, con los diseños del cliente
// encima) y adjunta al pedido. `config` guarda colores, diseños y posiciones
// para poder volver a editarlo. Ver OrderMockupService y
// frontend-emd/docs/plans/mockups-3d.md. Los listados NUNCA traen
// `imageData`/`config` (cada fila puede pesar varios MB).

model OrderMockup {
  id               Int      @id @default(autoincrement()) // Identificador único del mockup.
  orderId          Int // Clave foránea que referencia al Order al que se adjuntó.
  garment          String // Prenda del mockup: 'tshirt' | 'cap' | 'hoodie' | 'dress-shirt' | 'termo' | 'taza' (MOCKUP_GARMENTS de src/common/mockup-garments.ts).
  imageData        String? // Lámina exportada en base64 (sin prefijo data:), PNG o JPEG, máx. 8MB decodificada. Legacy: null si está en el almacenamiento de objetos.
  imageKey         String? // Clave del objeto (R2/S3) de la lámina. Si está, manda sobre imageData.
  imageMime        String // Mime type de la lámina: image/png | image/jpeg.
  config           Json // Configuración del estudio (MockupConfig del frontend: prenda, colores y capas de diseño) para volver a editarlo.
  createdById      Int? // Clave foránea que referencia al User que lo adjuntó (null si ese usuario se borró).
  branchEmployeeId Int? // Empleado de la sucursal que lo armó (opcional; sólo desde la cuenta de sucursal).
  createdAt        DateTime @default(now()) // Fecha en que se adjuntó el mockup.

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade) // Relación con Order: se borra junto con el pedido.
  createdBy      User?           @relation("OrderMockupCreatedBy", fields: [createdById], references: [id], onDelete: SetNull) // Relación con el User que lo adjuntó.
  branchEmployee BranchEmployee? @relation(fields: [branchEmployeeId], references: [id], onDelete: SetNull) // Empleado de la sucursal que lo armó.

  @@index([orderId])
}

// ─── Plantillas y biblioteca de logos de mockups ───────────────────────────
//
// Compartidas por toda la empresa (las administran Recepción, admin y
// superuser). Una plantilla guarda la configuración completa del estudio
// (prenda, colores, diseños embebidos) más una miniatura liviana para el
// panel; un logo es un PNG reutilizable con contador de usos para ordenar
// "más usados primero". Ver MockupTemplateService / MockupLogoService y
// frontend-emd/docs/plans/sidebar-y-mockups-v2.md.

model MockupTemplate {
  id            Int      @id @default(autoincrement()) // Identificador único de la plantilla.
  name          String // Nombre que le puso el usuario (máx. 80 caracteres).
  garment       String // Prenda de la plantilla: 'tshirt' | 'cap' | 'hoodie' | 'dress-shirt' | 'termo' | 'taza' (MOCKUP_GARMENTS de src/common/mockup-garments.ts).
  config        Json // Configuración del estudio (MockupConfig del frontend: prenda, colores y capas de diseño) que se aplica al elegirla. Máx. 8MB.
  thumbnailData String? // Miniatura en base64 (sin prefijo data:), PNG o JPEG, máx. 96KB decodificada. Se lista junto con la plantilla. Legacy: null si está en el almacenamiento de objetos.
  thumbnailKey  String? // Clave del objeto (R2/S3) de la miniatura. Si está, manda sobre thumbnailData.
  thumbnailMime String // Mime type de la miniatura: image/png | image/jpeg.
  createdById   Int? // Clave foránea que referencia al User que la guardó (null si ese usuario se borró).
  createdAt     DateTime @default(now()) // Fecha en que se guardó la plantilla.
  updatedAt     DateTime @updatedAt // Última modificación (ej. renombrarla).

  createdBy User? @relation("MockupTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull) // Relación con el User que la guardó.

  @@index([createdAt]) // Listado "más nuevas primero".
}

model MockupLogo {
  id            Int       @id @default(autoincrement()) // Identificador único del logo.
  name          String // Nombre del logo (máx. 80 caracteres).
  imageData     String? // Imagen PNG en base64 (sin prefijo data:), máx. 2MB decodificada. Nunca se trae en el listado. Legacy: null si está en el almacenamiento de objetos.
  imageKey      String? // Clave del objeto (R2/S3) de la imagen. Si está, manda sobre imageData.
  imageMime     String // Mime type de la imagen: image/png.
  thumbnailData String? // Miniatura PNG en base64 (sin prefijo data:), máx. 160px de lado y 24KB, para la grilla de logos. Nunca se trae en el listado: se pide por tarjeta visible. Legacy: null si está en el almacenamiento de objetos.
  thumbnailKey  String? // Clave del objeto (R2/S3) de la miniatura. Si está, manda sobre thumbnailData.
  thumbnailMime String // Mime type de la miniatura: image/png.
  createdById   Int? // Clave foránea que referencia al User que lo subió (null si ese usuario se borró).
  createdAt     DateTime  @default(now()) // Fecha en que se subió el logo.
  useCount      Int       @default(0) // Veces que se agregó a un mockup (para ordenar "más usados primero").
  lastUsedAt    DateTime? // Última vez que se agregó a un mockup. Null = nunca se usó.

  createdBy User? @relation("MockupLogoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull) // Relación con el User que lo subió.

  @@index([useCount, lastUsedAt]) // Listado "más usados primero" (useCount desc, lastUsedAt desc).
}

// ─── Cotizaciones ───────────────────────────────────────────────────────────
//
// Tablero de cotizaciones de Recepción: reemplaza la lista que se llevaba por
// WhatsApp. Cada cotización está en una etapa (`por_enviar` | `enviada`) y
// un subestado que pertenece a esa etapa (QUOTE_STATUSES_BY_STAGE de
// src/quote/quote.constants.ts). Cuando el cliente la acepta se puede
// convertir en pedido (`orderId`). Ver QuoteService y
// frontend-emd/docs/plans/cotizaciones.md.

model Quote {
  id           Int       @id @default(autoincrement()) // Identificador único de la cotización.
  clientId     Int? // Clave foránea que referencia al Client (opcional: puede ser un cliente libre por nombre; null también si el cliente se borró).
  clientName   String // Nombre del cliente tal como se muestra: texto libre o el nombre del cliente registrado al momento de cargarla (máx. 120 caracteres).
  description  String // Qué se cotiza (máx. 1000 caracteres).
  stage        String // Etapa: 'por_enviar' | 'enviada'.
  status       String // Subestado dentro de la etapa: por_enviar → 'lista' | 'pendiente_medidas' | 'info' | 'esperando_montaje'; enviada → 'esperando_respuesta' | 'aceptada' | 'no_aceptada' | 'comentarios'.
  comment      String? // Comentario libre (máx. 1000 caracteres), útil en 'comentarios' / 'no_aceptada'.
  priorityDate DateTime? @db.Date // Fecha de prioridad (para cuándo hay que mandarla). Null = prioridad normal.
  sentAt       DateTime? // Momento en que pasó a la etapa 'enviada' (null mientras está por enviar).
  orderId      Int?      @unique // Clave foránea que referencia al Order en que se convirtió (sólo si fue aceptada; null si el pedido se borró).
  createdById  Int? // Clave foránea que referencia al User que la dio de alta (null si ese usuario se borró).
  createdAt    DateTime  @default(now()) // Fecha de alta de la cotización.
  updatedAt    DateTime  @updatedAt // Última modificación (cambio de etapa, subestado, comentario, etc.).

  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull) // Relación con Client: si se borra el cliente, la cotización queda con el nombre escrito.
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull) // Relación con el Order en que se convirtió.
  createdBy User?   @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull) // Relación con el User que la dio de alta.

  @@index([stage, status]) // Pestañas y chips de subestado.
  @@index([priorityDate]) // Prioridad vencida/hoy/mañana primero.
  @@index([updatedAt]) // Luego, lo último que se movió.
  @@index([clientId]) // Cotizaciones de un cliente (y el SET NULL al borrarlo).
}

// ─── Sucursales ────────────────────────────────────────────────────────────
//
// Una sucursal (ej. "Punto Madero") es una extensión de la matriz, no otra
// empresa: entra con UNA cuenta compartida (rol 'sucursal', User.branchId) que
// sólo puede levantar pedidos, usar Mockups y ver sus propios pedidos. Quién
// levantó cada pedido se elige de la lista de empleados de la sucursal, que
// administra admin desde Usuarios. Ver BranchService.

model Branch {
  id        Int      @id @default(autoincrement()) // Identificador único de la sucursal.
  name      String   @unique // Nombre visible (ej. "Punto Madero"); se muestra como badge en pedidos.
  active    Boolean  @default(true) // Sucursal inactiva: su cuenta no puede levantar pedidos.
  createdAt DateTime @default(now()) // Fecha de alta.

  users     User[] // Cuentas de la sucursal (normalmente una compartida).
  employees BranchEmployee[] // Empleados que levantan pedidos desde la cuenta compartida.
  orders    Order[] // Pedidos levantados desde la sucursal.
  clients   Client[] // Clientes propios de la sucursal (los de la matriz tienen branchId null).
}

model BranchEmployee {
  id        Int      @id @default(autoincrement()) // Identificador único del empleado.
  branchId  Int // Clave foránea que referencia a Branch.
  name      String // Nombre visible (ej. "Ana López"), máx. 80 caracteres.
  active    Boolean  @default(true) // Inactivo = ya no aparece para elegir al crear pedidos (los pedidos viejos lo siguen mostrando).
  createdAt DateTime @default(now()) // Fecha de alta.
  updatedAt DateTime @updatedAt // Última modificación (renombrar / activar).

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade) // Sucursal a la que pertenece.
  orders       Order[] // Pedidos que levantó.
  orderMockups OrderMockup[] // Mockups que armó.

  @@unique([branchId, name])
  @@index([branchId])
}
