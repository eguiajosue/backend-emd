generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id       Int     @id @default(autoincrement()) // Identificador único de la empresa.
  name     String  @unique // Nombre de la empresa.
  phone    String? // Número de teléfono de la empresa.
  email    String? // Dirección de correo electrónico de la empresa.
  address  String? // Dirección física de la empresa.
  location String? // Ubicación de la empresa (por ejemplo, ciudad, estado).

  clients Client[] // Relación uno a muchos con el modelo Client.
}

model Client {
  id         Int     @id @default(autoincrement()) // Identificador único del cliente.
  companyId  Int? // Clave foránea que referencia a Company.
  first_name String // Nombre del cliente.
  last_name  String? // Apellido del cliente (opcional).
  phone      String? // Número de teléfono del cliente.
  email      String? // Dirección de correo electrónico del cliente.
  address    String? // Dirección física del cliente.

  company Company? @relation(fields: [companyId], references: [id]) // Relación con Company.
  orders  Order[] // Relación uno a muchos con el modelo Order.

  @@index([companyId])
  @@index([last_name, first_name])
}

model Role {
  id    Int    @id @default(autoincrement()) // Identificador único del rol.
  name  String @unique // Nombre del rol (por ejemplo, Admin, User).
  users User[] // Relación muchos a muchos con el modelo User.
}

model User {
  id              Int     @id @default(autoincrement()) // Identificador único del usuario.
  firstName       String // Nombre del usuario.
  lastName        String? // Apellido del usuario.
  username        String  @unique // Nombre de usuario único para iniciar sesión.
  password        String // Contraseña del usuario.
  isSharedAccount Boolean @default(false) // Cuenta compartida por varias personas de un área (ej. "Taller"), en vez de una persona.

  roles                   Role[] // Relación muchos a muchos con Role: un usuario puede tener uno o más roles.
  orders                  Order[] // Relación uno a muchos con Order (pedidos creados por el usuario).
  assignedOrders          Order[]                  @relation("AssignedOrders") // Pedidos asignados a este usuario para trabajarlos.
  assignedAreaTasks       OrderAreaTask[]          @relation("AssignedAreaTasks") // Tareas de área de producción asignadas a este usuario (o a su cuenta de área).
  logs                    Log[] // Relación uno a muchos con Log.
  orderNotes              OrderNote[] // Notas internas de pedidos escritas por este usuario.
  orderAuditLogs          OrderAuditLog[] // Registros de auditoría de ediciones de pedidos hechas por este usuario.
  notifications           Notification[] // Notificaciones persistentes dirigidas a este usuario.
  designRevisionsSent     DesignRevision[]         @relation("DesignRevisionSentBy") // Montajes enviados por este usuario (diseñador).
  designRevisionsFeedback DesignRevision[]         @relation("DesignRevisionFeedbackBy") // Feedback cargado por este usuario (Recepción).
  designRevisionsApproved DesignRevision[]         @relation("DesignRevisionApprovedBy") // Autorizaciones marcadas por este usuario (Recepción).
  chatMemberships         ChatConversationMember[] // Conversaciones de chat en las que participa (incluye monitoreo de admin).
  chatMessages            ChatMessage[] // Mensajes de chat enviados por este usuario.
  chatDirectAsUserA       ChatConversation[]       @relation("ChatDirectUserA") // DMs donde es el participante de id menor.
  chatDirectAsUserB       ChatConversation[]       @relation("ChatDirectUserB") // DMs donde es el participante de id mayor.

  themePreference    String? // Preferencia de tema: 'light' | 'dark' | 'system'.
  accentColor        String? // Nombre de preset (ej "rose") o hex custom (ej "#3366ff").
  languagePreference String? // Idioma preferido: 'es' | 'en'.
  glassIntensity     Int? // Intensidad del efecto Liquid Glass, 0-100.
  density            String? // Densidad de UI: 'comfortable' | 'compact'.
  hasSeenOnboarding  Boolean? // Si ya completó/cerró el tour de onboarding.
  areaViewMode       String? // Cómo ver las tareas de producción: 'unified' (todo junto, etiquetado por área) | 'split' (una vista por área). Preferencia personal, ver WORKFLOW.md §4.
}

model Status {
  id                     Int            @id @default(autoincrement()) // Identificador único del estado.
  name                   String         @unique // Nombre del estado (por ejemplo, Pendiente).
  orders                 Order[] // Relación uno a muchos con Order.
  previousOrderHistories OrderHistory[] @relation("PreviousStatus") // Relación con OrderHistory donde este estado es el estado anterior.
  newOrderHistories      OrderHistory[] @relation("NewStatus") // Relación con OrderHistory donde este estado es el nuevo estado.
}

model Order {
  id                 Int       @id @default(autoincrement()) // Identificador único de la orden.
  clientId           Int? // Clave foránea que referencia a Client (opcional: puede haber cliente libre por nombre).
  clientNameOverride String? // Nombre de cliente escrito a mano cuando no se selecciona un cliente registrado.
  userId             Int // Clave foránea que referencia al User que creó la orden.
  assignedUserId     Int? // Clave foránea que referencia al User asignado para trabajar la orden.
  statusId           Int // Clave foránea que referencia a Status (flujo: pendiente→en proceso→terminado→entregado, o el flujo con diseño: en diseño→esperando autorización→cambios solicitados→autorizado→...).
  area               String? // Departamento DONDE ESTÁ AHORA el pedido (gobierna visibilidad): taller | dtf | bordado | diseno | laser | impresiones.
  description        String // Descripción de la orden.
  creationDate       DateTime // Fecha en que se creó la orden.
  deliveryDate       DateTime? // Fecha de entrega opcional.

  requiresDesign Boolean @default(true) // Si el pedido pasa por la fase de Diseño antes de producción (decidido por Recepción al crear el pedido).
  productionArea String? // Área de producción destino una vez autorizado el diseño (uno de ORDER_AREAS salvo 'diseno'). Editable por recepción/admin/superuser y por usuarios con rol diseno.

  authorizationFileData String? // Contenido en base64 (sin prefijo data:) de la hoja de autorización.
  authorizationFileName String? // Nombre de archivo original de la hoja de autorización.
  authorizationFileMime String? // Mime type de la hoja de autorización (image/png, image/jpeg, application/pdf).

  client          Client?          @relation(fields: [clientId], references: [id]) // Relación con Client (opcional).
  user            User             @relation(fields: [userId], references: [id]) // Relación con User (creador).
  assignedUser    User?            @relation("AssignedOrders", fields: [assignedUserId], references: [id]) // Relación con User asignado.
  status          Status           @relation(fields: [statusId], references: [id]) // Relación con Status.
  histories       OrderHistory[] // Relación uno a muchos con OrderHistory.
  orderProducts   OrderProduct[] // Líneas de producto del pedido.
  notes           OrderNote[] // Notas/comentarios internos sobre el pedido.
  auditLogs       OrderAuditLog[] // Auditoría de ediciones del pedido.
  notifications   Notification[] // Notificaciones persistentes que referencian este pedido.
  designRevisions DesignRevision[] // Rondas de montaje/feedback/autorización de la fase de Diseño.
  chatMessages    ChatMessage[] // Mensajes del chat interno que referencian este pedido como contexto.
  areaTasks       OrderAreaTask[] // Trabajo de producción por área; varias áreas avanzan en paralelo (ver WORKFLOW.md §3).

  @@index([statusId])
  @@index([clientId])
  @@index([userId])
  @@index([assignedUserId])
  @@index([deliveryDate])
  @@index([creationDate])
  @@index([area])
}

model DesignRevision {
  id      Int @id @default(autoincrement()) // Identificador único de la ronda de diseño.
  orderId Int // Clave foránea que referencia a Order.
  round   Int // Número de ronda dentro del pedido: 1, 2, 3... (max(round)+1 al crear).

  // Montaje enviado por Diseño (imagen/PDF), una versión por ronda.
  montageFileData String? // Contenido en base64 (sin prefijo data:) del montaje.
  montageFileName String? // Nombre de archivo original del montaje.
  montageFileMime String? // Mime type del montaje (image/png, image/jpeg, application/pdf).
  sentAt          DateTime? // Fecha en que Diseño envió el montaje.
  sentByUserId    Int? // Clave foránea que referencia al User (diseñador) que envió el montaje.

  // Feedback del cliente, cargado por Recepción.
  feedbackText     String? // Texto del feedback del cliente (máx. 2000 caracteres, validado en el DTO).
  feedbackFileData String? // Contenido en base64 (sin prefijo data:) del adjunto de feedback.
  feedbackFileName String? // Nombre de archivo original del adjunto de feedback.
  feedbackFileMime String? // Mime type del adjunto de feedback.
  feedbackAt       DateTime? // Fecha en que Recepción cargó el feedback.
  feedbackByUserId Int? // Clave foránea que referencia al User (Recepción) que cargó el feedback.

  // Resolución: el cliente autorizó esta ronda.
  approved         Boolean   @default(false) // Si el cliente autorizó esta ronda de montaje.
  approvedAt       DateTime? // Fecha de autorización.
  approvedByUserId Int? // Clave foránea que referencia al User (Recepción) que marcó la autorización.

  createdAt DateTime @default(now()) // Fecha de creación de la ronda.

  order          Order @relation(fields: [orderId], references: [id], onDelete: Cascade) // Relación con Order (se borra en cascada si se borra el pedido).
  sentByUser     User? @relation("DesignRevisionSentBy", fields: [sentByUserId], references: [id]) // Relación con User que envió el montaje.
  feedbackByUser User? @relation("DesignRevisionFeedbackBy", fields: [feedbackByUserId], references: [id]) // Relación con User que cargó el feedback.
  approvedByUser User? @relation("DesignRevisionApprovedBy", fields: [approvedByUserId], references: [id]) // Relación con User que autorizó.

  @@index([orderId])
  @@index([orderId, round])
}

model OrderNote {
  id        Int      @id @default(autoincrement()) // Identificador único de la nota.
  orderId   Int // Clave foránea que referencia a Order.
  userId    Int // Clave foránea que referencia al User autor de la nota.
  text      String // Contenido de la nota (máx. 2000 caracteres, validado en el DTO).
  createdAt DateTime @default(now()) // Fecha de creación de la nota.

  order Order @relation(fields: [orderId], references: [id]) // Relación con Order.
  user  User  @relation(fields: [userId], references: [id]) // Relación con User autor.

  @@index([orderId])
  @@index([userId])
}

model OrderAuditLog {
  id        Int      @id @default(autoincrement()) // Identificador único del registro de auditoría.
  orderId   Int // Clave foránea que referencia a Order.
  userId    Int // Clave foránea que referencia al User que realizó la acción.
  action    String // Acción realizada: "created" | "updated" | etc.
  changes   Json // Diff de campos: { campo: { before, after } }.
  createdAt DateTime @default(now()) // Fecha del registro de auditoría.

  order Order @relation(fields: [orderId], references: [id]) // Relación con Order.
  user  User  @relation(fields: [userId], references: [id]) // Relación con User que hizo el cambio.

  @@index([orderId])
  @@index([userId])
}

model OrderHistory {
  id               Int      @id @default(autoincrement()) // Identificador único del registro de historial de la orden.
  orderId          Int // Clave foránea que referencia a Order.
  previousStatusId Int // Clave foránea que referencia al estado anterior en Status.
  newStatusId      Int // Clave foránea que referencia al nuevo estado en Status.
  changeDate       DateTime @default(now()) // Fecha y hora en que ocurrió el cambio de estado.

  order          Order  @relation(fields: [orderId], references: [id]) // Relación con Order.
  previousStatus Status @relation("PreviousStatus", fields: [previousStatusId], references: [id]) // Relación con el estado anterior en Status.
  newStatus      Status @relation("NewStatus", fields: [newStatusId], references: [id]) // Relación con el nuevo estado en Status.

  @@index([orderId])
  @@index([changeDate])
  @@index([previousStatusId])
  @@index([newStatusId])
}

/// Estado de una tarea de área. Independiente de `Status` (el estado global del
/// pedido): acá el ciclo es corto y siempre el mismo, sin importar el área.
enum AreaTaskStatus {
  pendiente
  en_proceso
  terminado
}

/// Trabajo que le toca a UN área dentro de un pedido.
///
/// Un pedido puede necesitar varias áreas (ej. bordado + dtf) y todas trabajan
/// EN PARALELO: cada una lleva su propio estado y su propio responsable, sin
/// esperar a las demás. Cuando todas quedan en `terminado`, el pedido pasa solo
/// a "listo para entregar"; la entrega la confirma Recepción a mano.
/// Ver WORKFLOW.md §3.
model OrderAreaTask {
  id             Int            @id @default(autoincrement())
  orderId        Int // Pedido al que pertenece esta tarea.
  area           String // Área que la trabaja: taller | dtf | bordado | laser | impresiones (nunca 'diseno').
  status         AreaTaskStatus @default(pendiente) // Avance de esta área en particular.
  assignedUserId Int? // Responsable. Por defecto la cuenta compartida del área; alguien del área puede tomarla.
  createdAt      DateTime       @default(now())
  startedAt      DateTime? // Cuándo pasó a en_proceso.
  completedAt    DateTime? // Cuándo pasó a terminado.

  order        Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignedUser User? @relation("AssignedAreaTasks", fields: [assignedUserId], references: [id])

  // Un área no puede aparecer dos veces en el mismo pedido.
  @@unique([orderId, area])
  @@index([orderId])
  @@index([area])
  @@index([assignedUserId])
  @@index([status])
}

/// El catálogo de productos y el inventario (ProductType, Color, Size, Product,
/// InventoryTransaction) se retiraron: existían en la base y en la API pero
/// nunca tuvieron interfaz, y los pedidos siempre guardaron el producto como
/// texto libre (`OrderProduct.customName`), así que ningún pedido descontaba
/// stock. Al retirarlos las cinco tablas estaban vacías y ninguna línea de
/// pedido referenciaba un producto. Ver la migración
/// 20260907220000_remove_inventory.

model OrderProduct {
  id         Int     @id @default(autoincrement()) // Identificador único de la línea de producto del pedido.
  orderId    Int // Clave foránea que referencia a Order.
  customName String // Nombre del producto, escrito a mano o elegido de OrderProductPreset.
  quantity   Int // Cantidad del producto en la orden.

  order Order @relation(fields: [orderId], references: [id]) // Relación con Order.

  @@index([orderId])
}

model OrderProductPreset {
  id   Int    @id @default(autoincrement()) // Identificador único del preset.
  name String @unique // Nombre del producto frecuente (ej. "Lona", "X-Banner").
}

model AreaVisibilitySetting {
  id                 Int     @id @default(autoincrement()) // Identificador único de la configuración.
  role               String  @unique // Rol operativo ('taller' | 'dtf' | 'bordado' | 'diseno' | 'laser' | 'impresiones').
  generalViewEnabled Boolean @default(true) // Si es true, todos los usuarios del rol ven todos los pedidos de su etapa; si es false, solo ven los pedidos sin asignar o asignados a ellos mismos.
}

model AppSetting {
  id                      Int @id @default(1) // Fila única de configuración global (siempre id=1).
  deliveredRetentionHours Int @default(48) // Horas que un pedido "entregado" sigue visible en el tablero en vivo.
}

model Notification {
  id        Int      @id @default(autoincrement()) // Identificador único de la notificación.
  userId    Int // Clave foránea que referencia al User destinatario.
  type      String // Tipo de notificación (ej. "order_assigned", "order_status_changed"), abierto a futuros tipos.
  title     String // Título corto de la notificación.
  body      String? // Cuerpo/detalle opcional de la notificación.
  orderId   Int? // Clave foránea opcional que referencia a Order, para poder linkear "ver pedido".
  read      Boolean  @default(false) // Si el usuario ya la marcó como leída.
  createdAt DateTime @default(now()) // Fecha de creación de la notificación.

  user  User   @relation(fields: [userId], references: [id]) // Relación con User destinatario.
  order Order? @relation(fields: [orderId], references: [id]) // Relación opcional con Order.

  @@index([userId, read])
  @@index([orderId])
}

model Log {
  id      Int      @id @default(autoincrement()) // Identificador único del registro.
  userId  Int // Clave foránea que referencia a User.
  logDate DateTime @default(now()) // Fecha y hora en que se registró la acción.
  action  String // Descripción de la acción realizada.

  user User @relation(fields: [userId], references: [id]) // Relación con User.

  @@index([userId])
  @@index([logDate])
}

/// Conversación del chat interno. Dos tipos:
/// - `area`: canal fijo Recepción ↔ un área operativa (uno por área, `area` único).
/// - `direct`: mensaje directo 1 a 1 entre dos usuarios (`directUserAId` < `directUserBId`).
/// La membresía se deriva SIEMPRE de estas columnas + los roles del usuario
/// (ver ChatService.assertConversationAccess); `ChatConversationMember` es un
/// cache de la membresía para poder guardar el marcador de leídos.
model ChatConversation {
  id            Int       @id @default(autoincrement()) // Identificador único de la conversación.
  type          String // 'area' | 'direct'.
  area          String?   @unique // Área operativa del canal (sólo para type='area'): taller | dtf | bordado | diseno | laser | impresiones.
  directUserAId Int? // Primer participante del DM (el de id menor), sólo para type='direct'.
  directUserBId Int? // Segundo participante del DM (el de id mayor), sólo para type='direct'.
  directKey     String?   @unique // Clave canónica "menorId:mayorId" para garantizar un único DM por par de usuarios.
  createdAt     DateTime  @default(now()) // Fecha de creación de la conversación.
  lastMessageAt DateTime? // Fecha del último mensaje, para ordenar la lista de conversaciones.

  directUserA User? @relation("ChatDirectUserA", fields: [directUserAId], references: [id])
  directUserB User? @relation("ChatDirectUserB", fields: [directUserBId], references: [id])

  members  ChatConversationMember[] // Membresías materializadas (marcador de leídos).
  messages ChatMessage[] // Mensajes de la conversación.

  @@index([type])
  @@index([lastMessageAt])
}

/// Membresía materializada de un usuario en una conversación. NO es la fuente
/// de verdad de la autorización (eso lo resuelve ChatService a partir de los
/// roles): existe para persistir `lastReadAt` (badge de no leídos) y para
/// poder mostrar la lista de participantes, marcando a los admin como
/// monitores.
model ChatConversationMember {
  id             Int       @id @default(autoincrement()) // Identificador único de la membresía.
  conversationId Int // Clave foránea que referencia a ChatConversation.
  userId         Int // Clave foránea que referencia al User miembro.
  isMonitor      Boolean   @default(false) // true para admin/superuser: participan para monitoreo, visible en la lista de participantes.
  lastReadAt     DateTime? // Fecha del último mensaje leído por este usuario en la conversación.
  joinedAt       DateTime  @default(now()) // Fecha en que se materializó la membresía.

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
}

/// Mensaje de chat persistido. La entrega en vivo va por WebSocket
/// (NotificationsGateway.emitChatMessage), igual que las notificaciones:
/// se persiste y además se emite, para que el historial sobreviva al reload.
model ChatMessage {
  id             Int      @id @default(autoincrement()) // Identificador único del mensaje.
  conversationId Int // Clave foránea que referencia a ChatConversation.
  senderId       Int // Clave foránea que referencia al User que lo envió.
  body           String? // Contenido del mensaje (texto plano). Opcional si hay adjunto.
  // Referencia opcional a un pedido, para dar contexto sin que sea
  // obligatorio en cada mensaje (ej. "che, mirá el pedido #123"). `SetNull`
  // en vez de `Cascade`: si el pedido se borra, el mensaje sobrevive sin la
  // referencia en lugar de desaparecer.
  orderId        Int?
  // Adjunto opcional (foto, documento o audio). Mismo esquema que
  // Order.authorizationFile*: el contenido va en base64 directo en la
  // columna (sin storage externo), y el tipo/tamaño se validan en
  // ChatService.sendMessage (magic-byte sniffing con `file-type`, igual que
  // OrderService.assertAuthorizationFileSize).
  attachmentData     String?
  attachmentFilename String?
  attachmentMimeType String?
  attachmentSize     Int?
  createdAt      DateTime @default(now()) // Fecha de envío.

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [senderId], references: [id])
  order        Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([orderId])
}

// Log de auditoría genérico (independiente de `OrderAuditLog`, que sólo
// cubre cambios de campos de un pedido puntual). Pensado para eventos que no
// tienen necesariamente un `orderId` (ej. exportación CSV de varios pedidos)
// o que agrupan varias entidades (ej. una acción masiva). Sin relación FK a
// `User`/`Order`: así el registro sobrevive aunque se borre el actor o la
// entidad referenciada, y no exige que `entityId` sea siempre un id de
// pedido.
model AuditLog {
  id           Int      @id @default(autoincrement()) // Identificador único del registro.
  actorUserId  Int // Id del usuario que ejecutó la acción (sin FK, ver nota arriba).
  action       String // Acción realizada: "order.bulk_status_update" | "order.csv_export" | etc.
  entityType   String // Tipo de entidad afectada: "order" | "order_bulk" | "order_export" | etc.
  entityId     String // Id (o ids serializados/"bulk") de la entidad afectada.
  metadata     Json? // Detalle adicional de la acción (ids afectados, filtros usados, resultado, etc.).
  createdAt    DateTime @default(now()) // Fecha del registro.

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
}
